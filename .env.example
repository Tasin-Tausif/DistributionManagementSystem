# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (Laravel expects these)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dms
DB_USERNAME=dms
DB_PASSWORD=dms_password

# MySQL/TiDB service credentials (used by compose for local dev)
MYSQL_DATABASE=dms
MYSQL_USER=dms
MYSQL_PASSWORD=dms_password
MYSQL_ROOT_PASSWORD=root_password
